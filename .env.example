APP_NAME=DocAgent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=docagent
DB_USERNAME=docagent
DB_PASSWORD=secret

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
# local disk (default) or `s3` for Render + Cloudflare R2 / AWS S3 / Backblaze B2
DOCUMENTS_DISK=documents
# Optional: mount a Render persistent disk here when staying on the local driver
# DOCUMENTS_ROOT=/var/data/documents
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@docagent.test"
MAIL_FROM_NAME="${APP_NAME}"

# DeepSeek powers widget chat completions (OpenAI-compatible).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# DeepSeek does not host an embeddings API. Use `openai` for any
# OpenAI-compatible embeddings host (Jina, OpenAI, Ollama, etc.).
EMBEDDING_DRIVER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16

RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.08
DOCUMENT_CHUNK_TOKENS=750
DOCUMENT_CHUNK_OVERLAP=80

# Object storage (Cloudflare R2 recommended on Render). Leave empty for local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ROOT=documents
